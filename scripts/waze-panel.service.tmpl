[Unit]
Description=Waze Panel - OpenVPN admin panel
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/waze-panel/panel.env
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port __PANEL_PORT__ --workers 1
Restart=on-failure
RestartSec=3
User=root
Group=root

# A single worker is required: the traffic-accounting scheduler and the
# in-memory online-user tracker both assume one process.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
