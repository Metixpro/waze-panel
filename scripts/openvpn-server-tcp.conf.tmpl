# Waze Panel — OpenVPN TCP instance
# Rendered by install.sh. Placeholders: __TCP_PORT__ __APP_DIR__ __TCP_MGMT_PORT__ __OVPN_GROUP__

port __TCP_PORT__
proto tcp4-server
dev tun-waze-tcp
topology subnet

ca /etc/openvpn/easy-rsa/pki/ca.crt
cert /etc/openvpn/easy-rsa/pki/issued/server.crt
key /etc/openvpn/easy-rsa/pki/private/server.key
dh /etc/openvpn/server/dh.pem
crl-verify /etc/openvpn/server/crl.pem
# tls-crypt / tls-crypt-v2 keys and the HTTPS cover (port-share) are set
# from the panel's Settings page, which rewrites this file:
config /etc/openvpn/server/waze-tcp.panel.conf

server 10.9.0.0 255.255.255.0
ifconfig-pool-persist /etc/openvpn/server/ipp-tcp.txt

push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 1.1.1.1"
push "dhcp-option DNS 8.8.8.8"

keepalive 10 60
cipher AES-256-GCM
auth SHA256
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
tcp-nodelay
push "tcp-nodelay"
sndbuf 524288
rcvbuf 524288
push "sndbuf 524288"
push "rcvbuf 524288"

user nobody
group __OVPN_GROUP__
persist-key
persist-tun

status /etc/openvpn/server/status-tcp.log
status-version 3
log-append /var/log/openvpn/tcp.log
verb 3

management 127.0.0.1 __TCP_MGMT_PORT__

script-security 2
client-connect __APP_DIR__/scripts/client-connect-tcp.py
client-disconnect __APP_DIR__/scripts/client-disconnect-tcp.py

# Username/password logins (per user, set in the panel). Every client runs
# through the auth hook: certificate-only users need no credentials,
# "certificate + password" users need both, and password-only users may
# connect with the shared certificate-less profile. Never add
# username-as-common-name: it would let a certificate log in as another user.
verify-client-cert optional
auth-user-pass-verify __APP_DIR__/scripts/auth-verify-tcp.py via-file
auth-user-pass-optional
